# Copy to .env (excluded from version control) and fill in.
# This file declares the NAME of every value the automations read.
# It must never hold a real one.

# --- Account ---------------------------------------------------------------
# The REST API root. Change it only for GitHub Enterprise Server, where it is
# https://<host>/api/v3 - and note that is the API root, not the web interface.
GITHUB_API_URL=https://api.github.com

# The GraphQL endpoint. Unused until phase 5 (project-board); GraphQL has one
# endpoint for every query, which is why it is a URL of its own rather than a path.
GITHUB_GRAPHQL_URL=https://api.github.com/graphql

# The account login only. Not a URL, and not owner/repo.
# It lives here, not in project-context.json, because an account name is
# identifying data and that file is committed.
GITHUB_OWNER=

# --- Tokens ----------------------------------------------------------------
# USE FINE-GRAINED TOKENS, not classic ones. This is not a preference:
#
#   There is NO fine-grained permission equivalent to deleting a repository.
#   Deleting requires a classic token with the delete_repo scope. So choosing the
#   token type REMOVES the capability rather than restricting it - a structural
#   guarantee instead of a convention. A classic token with `repo` is all-or-nothing
#   and includes admin over your own repositories, which is branch protection.
#
# Create one at: Settings > Developer settings > Personal access tokens >
# Fine-grained tokens. Scope each one to the repositories it needs, and set the
# shortest expiry you can live with - repo-inventory reports the days remaining.
#
# One token per role, so an automation cannot reach past its job. repo-standards
# cannot touch a project board; project-board cannot write a file.

# Everything read-only. This is the ONLY one repo-inventory needs.
#   Repository permissions: Metadata: read
#                           Contents: read
#                           Issues: read
#                           Administration: read
GITHUB_TOKEN_READ=

# repo-metadata apply, from phase 3. Leave empty until then.
#   The read set, plus: Administration: read and write   (description, homepage, topics)
#                       Issues: read and write            (labels)
GITHUB_TOKEN_WRITE_METADATA=

# repo-standards apply, from phase 4. Leave empty until then.
#   The read set, plus: Contents: read and write          (creating a missing file)
GITHUB_TOKEN_WRITE_CONTENT=

# project-board, from phase 5. Leave empty until then.
#   Account permissions: Projects: read  (read and write once apply exists)
# Note that this is an ACCOUNT permission, not a repository one: Projects v2 belong
# to the account, not to a repository. A classic token needs read:project instead.
GITHUB_TOKEN_PROJECTS=
