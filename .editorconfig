# Layout rules for this repository.
#
# PSScriptAnalyzerSettings.psd1 excludes PSUseConsistentIndentation and says layout
# is governed by this file instead. It said that while this file did not exist, so
# the exclusion delegated to nothing - which is the "folklore" the same file warns
# about two comments earlier.
#
# The reason this file used to give is gone, and saying so is better than leaving a
# citation that no longer resolves.
#
# It read: tests/automations/SensitiveDataGate.Tests.ps1 extracts a function from
# scripts/Test-NoSensitiveData.ps1 with a regular expression anchored on a closing brace
# in column 0, so an indented brace broke it with "Could not extract" - a failure that
# names the wrong thing. Both files went with the PowerShell implementation, and the
# Python gate is imported rather than scraped, so that particular constraint no longer
# binds anything.
#
# What remains is ordinary and worth keeping: consistent layout, LF endings, and an
# indent width the linter agrees with. This repository has twice found a config file
# justifying itself by citing something that does not exist - AGENTS.md section 7 - so
# the honest note replaces the stale one rather than the rule quietly losing its
# reason.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
# ruff's default, and what the line-length rule in pyproject.toml is calibrated for.
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
# Trailing whitespace is a line break in Markdown.
trim_trailing_whitespace = false
